# Local doctrine working state; tracked harnesses live in scripts/bench/.
/dev-docs/

# Local cross-project coordination; messages are not project source.
/inbox/

# Installed dependencies and reproducible build/test output.
# No trailing slash: a worktree links node_modules rather than holding one.
/node_modules
/dist/
*.tsbuildinfo
/test-results/
/playwright-report/
/blob-report/
# Local Codex/Claude workflow skills are installation state, not public source.
/.claude/skills/
/.agents/skills/

# Python bytecode
scripts/**/__pycache__/

# Local validator digest cache; scripts/run_corrections.py owns its bound.
/.cache/
